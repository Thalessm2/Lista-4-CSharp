class Program //define uma class chamada Program
{
    static void Main() //define uma função chamada Main, que é o ponto de entrada do programa
    {
        Console.WriteLine("Você possui um diploma de ensino superior");
        bool possuiDiploma = Console.ReadLine().ToLower() == "sim"; //lê a resposta do usuário e converte para minúscula, comparando com "sim"
        Console.WriteLine("Sua idade e maior que 21 anos?");
        bool idadeMaiorQue21 = Console.ReadLine().ToLower() == "sim"; //lê a resposta do usuário e converte para minúscula, comparando com "sim"
        if (possuiDiploma && idadeMaiorQue21) //verifica se o usuário possui diploma e idade maior que 21 anos
        {
            Console.WriteLine("Parabéns você esta qualificado para a vaga de emprego!");//exibe a mensagem Parabéns você esta qualificado para a vaga de emprego!
        }
        else//se o usuário não possui diploma ou idade menor que 21 anos
        {
            Console.WriteLine("Sinto muito você nao está qualificado!" );//exibe a mensagem Sinto muito você nao está qualificado!
        }
    }
}
