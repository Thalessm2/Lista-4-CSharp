class Program //define uma class chamada Program
{
    static void Main() //define uma função chamada Main, que é o ponto de entrada do programa
    {
        {
            Console.Write("Digite o seu nome: ");//exibe uma mensagem no console pedindo para o usuário digitar o seu nome
            string nome = Console.ReadLine();// lê o nome digitado pelo usuário e armazena na variável nome

            Console.Write("Digite a sua idade: ");//exibe uma mensagem no console pedindo para o usuário digitar a sua idade
            int idade = int.Parse(Console.ReadLine());// lê a idade digitada pelo usuário, converte para inteiro e armazena na variável idade

            if (nome.Length > 3 && idade >= 18)//verifica se o nome tem mais de 3 caracteres e se a idade é maior ou igual a 18
            {
                Console.WriteLine("Acesso permitido");//exibe uma mensagem no console informando que o acesso foi permitido
            }
            else//se o nome tiver 3 caracteres ou menos, ou se a idade for menor que 18
            {
                Console.WriteLine("Acesso negado");//exibe uma mensagem no console informando que o acesso foi negado
            }
        }
    }
}

