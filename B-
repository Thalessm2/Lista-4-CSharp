class Program //define uma class chamada Program
{
    static void Main() //define uma função chamada Main, que é o ponto de entrada do programa
    {
        Console.WriteLine("Deseja comprar um carro novo?");//exibe uma mensagem no console perguntando se o usuário deseja comprar um carro novo
        bool desejaComprarCarro = Console.ReadLine().ToLower()=="sim";//verifica se o usuário deseja comprar um carro novo, convertendo a resposta para minúsculas e comparando com "sim"
        Console.WriteLine("Você possui dinheiro suficiente?");//exibe uma mensagem no console perguntando se o usuário possui dinheiro suficiente
        bool possuiDinheiroSuficiente = Console.ReadLine().ToLower() == "sim";//verifica se o usuário possui dinheiro suficiente, convertendo a resposta para minúsculas e comparando com "sim"
        if (desejaComprarCarro && possuiDinheiroSuficiente)//verifica se o usuário deseja comprar um carro novo e possui dinheiro suficiente
        {
            Console.WriteLine("Você pode comprar o carro!");//exibe uma mensagem no console informando que o usuário pode comprar o carro
        }
        else if (desejaComprarCarro && !possuiDinheiroSuficiente)//verifica se o usuário deseja comprar um carro novo, mas não possui dinheiro suficiente
        {
            Console.WriteLine("Você não possui dinheiro suficiente para comprar o carro.");//exibe uma mensagem no console informando que o usuário não possui dinheiro suficiente para comprar o carro
        }
        else if (!desejaComprarCarro && possuiDinheiroSuficiente)//verifica se o usuário não deseja comprar um carro novo, mas possui dinheiro suficiente
        {
            Console.WriteLine("Você possui dinheiro suficiente, mas não deseja comprar um carro.");//exibe uma mensagem no console informando que o usuário possui dinheiro suficiente, mas não deseja comprar um carro
        }
        else//caso contrário, ou seja, se o usuário não deseja comprar um carro novo e não possui dinheiro suficiente
        {
            Console.WriteLine("Você não deseja comprar um carro e não possui dinheiro suficiente.");//exibe uma mensagem no console informando que o usuário não deseja comprar um carro e não possui dinheiro suficiente
        }
    }
}
